# Frontend Environment Variables
ANGULAR_API_URL=http://localhost:8080/api

# Backend Database Configuration (LOCAL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/english_ascension
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password

# Backend Database Configuration (DEPLOY TEMPLATE)
# SPRING_DATASOURCE_URL=jdbc:postgresql://<render_db_host>:<port>/<render_database_name>
# SPRING_DATASOURCE_USERNAME=<render_username>
# SPRING_DATASOURCE_PASSWORD=<render_password>

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_MODEL=llama-3.3-70b-versatile

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here

# SMTP Mail Server Configuration (Gmail App Credentials)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
